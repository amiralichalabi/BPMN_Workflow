{
  "name": "bpmn-studio",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": { "ghcr.io/devcontainers/features/docker-in-docker:2": {} },
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "BPMN Studio", "visibility": "private" } },
  "postCreateCommand": "echo BEHIND_PROXY=true > .env && docker compose up -d --build"
}
